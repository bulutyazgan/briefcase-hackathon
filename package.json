{
  "name": "tally",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web \"bun run --cwd=server dev\" \"bun run --cwd=web dev\"",
    "seed": "bun run --cwd=server seed",
    "pdf:sample": "bun run --cwd=server pdf:sample",
    "typecheck": "bun run --filter '*' typecheck",
    "build": "bun run --cwd=web build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
