# Copy to server/.env. Never commit real values. Every key is optional unless noted.
# Variables with a default are commented out. An empty value overrides the default, so uncomment only to change it.

# Stripe test key. Must start with rk_test_ (restricted, preferred) or sk_test_. Billing is blocked without it.
STRIPE_SECRET_KEY=
# Points the Stripe SDK at a local mock, for example http://127.0.0.1:4010. Leave empty for real Stripe test mode.
# `bun run e2e` sets this itself and never reads server/.env.
# STRIPE_API_BASE=

# Extraction runs OpenAI first, then Fireworks, then deterministic heuristics when neither key is set.
# OpenAI key for extraction. OPENAI_MODEL defaults to gpt-5-mini.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# Fireworks key, tried after OpenAI for extraction, discount parsing, and Treg proposals.
FIREWORKS_API_KEY=

# Treg gateway token for buying leads. Without it, sourcing falls back to Firecrawl or server/seed/leads.csv.
TREG_TOKEN=
# Treg gateway base URL. Defaults to https://treg.to.
# TREG_BASE_URL=
# Firecrawl key, used for lead sourcing when Treg is unavailable.
FIRECRAWL_API_KEY=

# Cognee Cloud key and base URL for client memory. Without them, recall reads server/seed/memory.json.
COGNEE_API_KEY=
COGNEE_BASE_URL=

# Slack bot and app tokens for Socket Mode. Without them, only the in-app simulator runs.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Slack channel id that receives every staff note (invoice sent, approval needed, credit note, plan change). Needs SLACK_BOT_TOKEN.
# STAFF_SLACK_CHANNEL=
# Telegram chat id that receives the same staff notes. Needs TELEGRAM_BOT_TOKEN.
# STAFF_TELEGRAM_CHAT_ID=

# Telegram bot token for long polling. Without it, the Telegram channel is off.
TELEGRAM_BOT_TOKEN=
# Display name for the Telegram client. Defaults to the sender's Telegram name.
# TELEGRAM_CLIENT_NAME=
# Public URL of this server, used to turn /api links in Telegram replies into absolute links.
# PUBLIC_BASE_URL=

# Optional billing email for the seeded Louis demo client.
DEMO_BILLING_EMAIL=

# Comma-separated author names allowed to send /resume. Defaults to "Account owner".
# ACCOUNT_OWNER=
# SQLite ledger path, relative to server/. Defaults to tally.db.
# TALLY_DB_PATH=
# API port. Defaults to 8787. The web dev server proxies /api to 8787.
# PORT=
